# Aegis reads keys from the environment ONLY. Copy to .env and fill, or `source` your
# DeepSeek env file before a live run. NEVER commit real keys.

# DeepSeek (attacker / target / input-classifier). The vendored client accepts EITHER
# base-url variable name; the VPS skill-tuning env file sets OSSLLM_URL.
OSSLLM_API_KEY=
OSSLLM_MODEL=
OSSLLM_URL=
OSSLLM_BASE_URL=

# Cross-model targets (Phase 7, operator-gated; absent => those rows are gated, not faked)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cost gate for live gauntlet runs
AEGIS_LIVE=
AEGIS_MAX_USD=1.00
